{
  "$schema": "https://mintlify.com/docs.json",
  "name": "AgentWeb",
  "theme": "luma",
  "logo": {
    "light": "https://www.agentweb.us/logo-icon.png",
    "dark": "https://www.agentweb.us/logo-icon.png"
  },
  "favicon": "https://www.agentweb.us/logo-icon.png",
  "colors": {
    "primary": "#2CEDA6",
    "light": "#2CEDA6",
    "dark": "#2CEDA6"
  },
  "background": {
    "color": {
      "dark": "#05070C",
      "light": "#FBFAF8"
    }
  },
  "appearance": {
    "default": "dark"
  },
  "font": {
    "headings": {
      "family": "Newsreader"
    },
    "body": {
      "family": "Geist"
    }
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Create your key",
      "href": "https://www.agentweb.us/signup"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index", "quickstart", "install-agentweb"]
          },
          {
            "group": "Connect",
            "pages": ["agent-auth", "mcp-apps"]
          },
          {
            "group": "Reference",
            "pages": ["api", "scopes", "webhooks", "streaming", "sandbox"]
          },
          {
            "group": "Commerce",
            "pages": ["agent-commerce", "acp-ucp", "autonomous-agents"]
          },
          {
            "group": "Plans",
            "pages": ["pricing"]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "website": "https://www.agentweb.us"
    }
  }
}
